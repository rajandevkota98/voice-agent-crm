# Leave DRY_RUN=1 until the credentials below are real. In dry-run mode
# nothing is sent to WhatsApp or Twilio; the actions are only logged.
DRY_RUN=1
LOG_LEVEL=INFO
# LOG_FILE=logs/voice_crm.log
CRM_DB_PATH=crm.db

# Public HTTPS URL that Twilio and Meta can reach (ngrok or a deployed host).
PUBLIC_BASE_URL=https://your-tunnel.example.app

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=change-me

# Twilio voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# HubSpot private app token (free account). Leave empty to skip CRM sync.
HUBSPOT_ACCESS_TOKEN=

# OpenRouter. With a key set, voice turns go to an omni model that hears the caller directly.
# Paid audio models need credit on your OpenRouter account. Set a spending limit there.
OPENROUTER_API_KEY=
OMNI_MODEL=openai/gpt-audio-mini
COMPANY_KNOWLEDGE_PATH=company_knowledge.md

# WhatsApp templates. First contact with a lead must use an approved template.
# "hello_world" is pre-approved on Meta test numbers.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Google Sheet call log: the URL of the Apps Script web app you deploy (see README).
GOOGLE_SHEET_WEBHOOK_URL=
